{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fabrica-videos/EDIT_PLAN.schema.json",
  "title": "Fabrica Videos Edit Plan v2",
  "description": "Structural validation only. Cross-references, file existence, probed durations, gaps/overlaps and runtime are checked by validate_plan.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "episode", "global_style", "tracks", "assets", "narration", "scenes", "unresolved_items", "deliverables"],
  "properties": {
    "plan_version": { "const": "2.0" },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "language", "fps_num", "fps_den", "width", "height", "target_duration_frames", "style_guide", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
        "accent": { "type": ["string", "null"] },
        "fps_num": { "type": "integer", "minimum": 1 },
        "fps_den": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "target_duration_frames": { "type": "integer", "minimum": 1 },
        "runtime_tolerance_frames": { "type": "integer", "minimum": 0 },
        "style_guide": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved", "in_edit", "review", "final"] }
      }
    },
    "global_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fonts", "palette"],
      "properties": {
        "name": { "type": "string" },
        "lut_path": { "type": ["string", "null"] },
        "lut_target": { "type": ["string", "null"] },
        "lut_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thumbnail", "labels_and_captions"],
          "properties": {
            "thumbnail": { "type": "string" },
            "labels_and_captions": { "type": "string" }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/hex" }
        },
        "music_direction": { "type": "string" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_path", "voice_id", "accent", "approved", "segments"],
      "properties": {
        "script_path": { "type": "string" },
        "voice_id": { "type": ["string", "null"] },
        "accent": { "type": "string" },
        "pronunciation_notes_path": { "type": ["string", "null"] },
        "approved": { "type": "boolean" },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "asset_id", "source_in_seconds", "source_out_seconds"],
            "properties": {
              "segment_id": { "$ref": "#/$defs/id" },
              "asset_id": { "$ref": "#/$defs/id" },
              "source_in_seconds": { "type": "number", "minimum": 0 },
              "source_out_seconds": { "type": "number", "exclusiveMinimum": 0 },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "intentional_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_frame", "duration_frames", "reason"],
        "properties": {
          "start_frame": { "type": "integer", "minimum": 0 },
          "duration_frames": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    },
    "unresolved_items": { "type": "array", "items": { "type": "string" } },
    "deliverables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editable_project_path", "review_render_path", "final_render_path", "export_notes"],
      "properties": {
        "editable_project_path": { "type": ["string", "null"] },
        "review_render_path": { "type": ["string", "null"] },
        "final_render_path": { "type": ["string", "null"] },
        "export_notes": { "type": ["string", "null"] },
        "kind": { "enum": ["plan", "review_render", "editable_project", "final_render"] },
        "measured_loudness_lufs": { "type": ["number", "null"] },
        "measured_true_peak_dbtp": { "type": ["number", "null"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "transition": { "enum": ["hard_cut", "motivated_match_cut", "short_dissolve", "continuous_move", "none"] },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "track_type", "role", "layer_order"],
      "properties": {
        "track_id": { "$ref": "#/$defs/id" },
        "track_type": { "enum": ["video", "audio", "text"] },
        "role": { "enum": ["picture", "graphic", "narration", "music", "ambience", "sfx", "text"] },
        "layer_order": { "type": "integer" },
        "default_gain_db": { "type": "number", "maximum": 24 },
        "ducking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "duck_under_track_ids", "attenuation_db", "attack_ms", "release_ms"],
          "properties": {
            "enabled": { "type": "boolean" },
            "duck_under_track_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "attenuation_db": { "type": "number", "maximum": 0 },
            "attack_ms": { "type": "number", "minimum": 0 },
            "release_ms": { "type": "number", "minimum": 0 },
            "threshold_db": { "type": "number", "maximum": 0 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "role": { "enum": ["picture", "graphic"] } }, "required": ["role"] }, "then": { "properties": { "track_type": { "const": "video" } } } },
        { "if": { "properties": { "role": { "enum": ["narration", "music", "ambience", "sfx"] } }, "required": ["role"] }, "then": { "properties": { "track_type": { "const": "audio" } } } },
        { "if": { "properties": { "role": { "const": "text" } }, "required": ["role"] }, "then": { "properties": { "track_type": { "const": "text" } } } }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path", "asset_type", "source_url", "creator", "license", "attribution", "rights_status"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "\\\\" } },
        "asset_type": { "enum": ["video", "image", "audio", "font", "project", "other"] },
        "source_url": { "type": ["string", "null"] },
        "creator": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] },
        "rights_status": { "enum": ["cleared", "user_owned", "public_domain", "needs_review", "blocked"] },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
            "width": { "type": ["integer", "null"], "minimum": 1 },
            "height": { "type": ["integer", "null"], "minimum": 1 },
            "fps": { "type": ["number", "null"], "minimum": 0 },
            "has_audio": { "type": ["boolean", "null"] }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "act", "start_frame", "duration_frames", "timing_status", "purpose", "visual_direction", "narration", "clips", "audio_clips", "overlays", "edit", "verification"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/id" },
        "act": { "enum": ["hook", "promise", "orientation", "mechanism", "constraint", "consequence", "payoff", "other"] },
        "start_frame": { "type": "integer", "minimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "timing_status": { "enum": ["draft", "reconciled"] },
        "purpose": { "type": "string", "minLength": 1 },
        "visual_direction": { "type": "string", "minLength": 1 },
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "segment_ids"],
          "properties": {
            "text": { "type": "string" },
            "segment_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "silent_beat_purpose": { "type": "string" }
          }
        },
        "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visual_clip" } },
        "audio_clips": { "type": "array", "items": { "$ref": "#/$defs/audio_clip" } },
        "overlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } },
        "edit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shot_type", "movement", "grade_notes"],
          "properties": {
            "shot_type": { "enum": ["wide", "establishing", "medium", "detail", "macro", "diagram", "human_scale", "other"] },
            "shot_type_explanation": { "type": "string" },
            "movement": { "enum": ["static", "slow_push_in", "slow_pull_out", "slow_pan", "slow_tilt", "macro_track", "diagram_reveal", "other"] },
            "movement_explanation": { "type": "string" },
            "graphic": { "type": ["string", "null"] },
            "grade_notes": { "type": "string" }
          },
          "allOf": [
            { "if": { "properties": { "movement": { "const": "other" } }, "required": ["movement"] }, "then": { "required": ["movement_explanation"], "properties": { "movement_explanation": { "minLength": 1 } } } },
            { "if": { "properties": { "shot_type": { "const": "other" } }, "required": ["shot_type"] }, "then": { "required": ["shot_type_explanation"], "properties": { "shot_type_explanation": { "minLength": 1 } } } }
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim_ids", "visual_accuracy", "rights_checked"],
          "properties": {
            "claim_ids": { "type": "array", "items": { "type": "string" } },
            "visual_accuracy": { "type": "string" },
            "rights_checked": { "type": "boolean" }
          }
        }
      }
    },
    "visual_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "asset_id", "order", "track_id", "source_in_seconds", "source_out_seconds", "timeline_start_frame", "duration_frames", "fit_mode", "speed", "transition_in", "transition_out"],
      "properties": {
        "clip_id": { "$ref": "#/$defs/id" },
        "asset_id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer" },
        "track_id": { "$ref": "#/$defs/id" },
        "source_in_seconds": { "type": "number", "minimum": 0 },
        "source_out_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "timeline_start_frame": { "type": "integer", "minimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "fit_mode": { "enum": ["contain", "cover", "native"] },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "transition_in": { "$ref": "#/$defs/transition" },
        "transition_out": { "$ref": "#/$defs/transition" },
        "overlap_reason": { "type": "string", "minLength": 1 }
      }
    },
    "audio_clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "asset_id", "track_id", "source_in_seconds", "source_out_seconds", "timeline_start_frame", "duration_frames", "gain_db"],
      "properties": {
        "clip_id": { "$ref": "#/$defs/id" },
        "asset_id": { "$ref": "#/$defs/id" },
        "track_id": { "$ref": "#/$defs/id" },
        "source_in_seconds": { "type": "number", "minimum": 0 },
        "source_out_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "timeline_start_frame": { "type": "integer", "minimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "gain_db": { "type": "number", "maximum": 24 },
        "fade_in_frames": { "type": "integer", "minimum": 0 },
        "fade_out_frames": { "type": "integer", "minimum": 0 },
        "overlap_reason": { "type": "string", "minLength": 1 }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_id", "text", "role", "track_id", "start_offset_frames", "duration_frames", "style", "placement", "opacity"],
      "properties": {
        "overlay_id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "role": { "enum": ["title", "chapter", "label", "measurement", "subtitle", "source_credit", "other"] },
        "track_id": { "$ref": "#/$defs/id" },
        "start_offset_frames": { "type": "integer", "minimum": 0 },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": ["font_family", "weight", "size_px", "fill_hex"],
          "properties": {
            "font_family": { "type": "string", "minLength": 1 },
            "weight": { "type": ["integer", "string"] },
            "size_px": { "type": "number", "exclusiveMinimum": 0 },
            "fill_hex": { "$ref": "#/$defs/hex" },
            "outline": { "type": "object", "additionalProperties": false, "required": ["color_hex", "width_px"], "properties": { "color_hex": { "$ref": "#/$defs/hex" }, "width_px": { "type": "number", "minimum": 0 } } },
            "shadow": { "type": "object", "additionalProperties": false, "required": ["color_hex", "blur_px", "offset_x_px", "offset_y_px"], "properties": { "color_hex": { "$ref": "#/$defs/hex" }, "blur_px": { "type": "number", "minimum": 0 }, "offset_x_px": { "type": "number" }, "offset_y_px": { "type": "number" } } },
            "background": { "type": "object", "additionalProperties": false, "required": ["color_hex", "opacity"], "properties": { "color_hex": { "$ref": "#/$defs/hex" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } } }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "anchor", "alignment", "safe_margin"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "anchor": { "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"] },
            "alignment": { "enum": ["left", "center", "right"] },
            "safe_margin": { "type": "number", "minimum": 0, "maximum": 0.5 }
          }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fade_in_frames": { "type": "integer", "minimum": 0 },
        "fade_out_frames": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
